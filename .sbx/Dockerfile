FROM callumarnold/sandbox:pi

USER root

# julia: system setup
# The base Pi image provides just, curl, and CA certificates.
# Julia-specific tooling is installed in the user snippet.

USER 1000
ENV PATH=/home/agent/.local/bin:/home/agent/.julia/bin:/home/agent/.juliaup/bin:/home/agent/.config/pi/agent/bin:/usr/local/bin:/opt/node-v26.12.0/bin:/opt/pi/npm/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace

# julia: user setup
ENV JULIA_VERSION=1.13.2 FATOU_VERSION=v0.24.0 JULIAUP_HOME=/home/agent/.juliaup
RUN set -eux; \
    curl -fsSL https://install.julialang.org | sh -s -- -y --default-channel "$JULIA_VERSION"; \
    julia --version; \
    julia -e 'using Pkg; Pkg.Registry.add("General"); Pkg.Apps.add(url="https://github.com/julia-testitems/TestItemApp.jl")'; \
    juliati --version; just --version
RUN set -eux; \
    curl -fsSLo /tmp/fatou-installer.sh "https://github.com/jolars/fatou/releases/download/$FATOU_VERSION/fatou-installer.sh"; \
    FATOU_INSTALL_DIR=/home/agent/.local/bin FATOU_TAG="$FATOU_VERSION" sh /tmp/fatou-installer.sh; \
    rm /tmp/fatou-installer.sh; fatou --version

